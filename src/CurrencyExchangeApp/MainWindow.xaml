<Window x:Class="CurrencyExchangeApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:CurrencyExchangeApp.Converters"
        xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
        xmlns:vm="clr-namespace:CurrencyExchangeApp.Core.ViewModels;assembly=CurrencyExchangeApp.Core"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Currency Exchange — official NBRB rates"
        Width="1320"
        Height="840"
        MinWidth="1080"
        MinHeight="680"
        Icon="Assets/app.ico"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

  <Window.InputBindings>
    <KeyBinding Command="{Binding LoadCommand}" Gesture="F5" />
    <KeyBinding Command="{Binding SaveCommand}" Gesture="Ctrl+S" />
    <KeyBinding Command="{Binding ExportCsvCommand}" Gesture="Ctrl+E" />
  </Window.InputBindings>

  <Window.Resources>
    <conv:TrendBrushConverter x:Key="TrendBrush"
                              Down="{StaticResource DangerBrush}"
                              Flat="{StaticResource MutedTextBrush}"
                              Up="{StaticResource PublishedBrush}" />
    <Style x:Key="StatValue" TargetType="TextBlock">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="Margin" Value="0,4,0,2" />
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource CardBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="16,14" />
    </Style>
    <DataTemplate x:Key="TrackBallInfo">
      <StackPanel Margin="2">
        <TextBlock FontWeight="SemiBold" Text="{Binding DataPoint.Value, StringFormat=N4}" />
        <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="{Binding DataPoint.Category, StringFormat='{}{0:dd MMM yyyy}'}" />
      </StackPanel>
    </DataTemplate>

    <Style x:Key="PresetButton" TargetType="Button" BasedOn="{StaticResource SidebarButton}">
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="Margin" Value="0,0,6,6" />
      <Setter Property="FontSize" Value="12" />
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="300" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- ============================== Sidebar ============================== -->
    <Border Grid.RowSpan="2" Background="{StaticResource SidebarBrush}">
      <DockPanel Margin="16,20,16,16">

        <StackPanel Margin="4,0,0,22" DockPanel.Dock="Top" Orientation="Horizontal">
          <Image Width="38" Height="38" Source="Assets/logo.png" />
          <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
            <TextBlock FontSize="17" FontWeight="SemiBold" Foreground="White" Text="Currency Exchange" />
            <TextBlock FontSize="12" Foreground="{StaticResource SidebarMutedBrush}" Text="Official rates of the NBRB" />
          </StackPanel>
        </StackPanel>

        <!-- Period -->
        <StackPanel DockPanel.Dock="Top">
          <DockPanel>
            <TextBlock DockPanel.Dock="Right" Margin="0,0,4,0" FontSize="11" Foreground="{StaticResource SidebarMutedBrush}" Text="{Binding PeriodText}" />
            <TextBlock Style="{StaticResource SidebarHeader}" Text="PERIOD" />
          </DockPanel>
          <Border Style="{StaticResource SidebarSection}">
            <StackPanel>
              <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="8" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Margin="0,0,0,4" FontSize="11" Foreground="{StaticResource SidebarMutedBrush}" Text="From" />
                  <telerik:RadDatePicker Height="32" DateTimeWatermarkContent="Start date" SelectedValue="{Binding StartDate, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Margin="0,0,0,4" FontSize="11" Foreground="{StaticResource SidebarMutedBrush}" Text="To" />
                  <telerik:RadDatePicker Height="32" DateTimeWatermarkContent="End date" SelectedValue="{Binding EndDate, Mode=TwoWay}" />
                </StackPanel>
              </Grid>
              <ItemsControl ItemsSource="{Binding PeriodPresets}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:PeriodPreset}">
                    <Button Command="{Binding DataContext.ApplyPresetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"
                            Content="{Binding Label}"
                            Style="{StaticResource PresetButton}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock FontSize="12"
                         Foreground="#FCA5A5"
                         Text="{Binding PeriodError}"
                         TextWrapping="Wrap"
                         Visibility="{Binding PeriodError, Converter={StaticResource VisibleWhen}}" />
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Load, pinned to the bottom -->
        <StackPanel DockPanel.Dock="Bottom">
          <ProgressBar Height="4"
                       Margin="0,0,0,10"
                       Background="{StaticResource SidebarHoverBrush}"
                       BorderThickness="0"
                       Foreground="{StaticResource AccentBrush}"
                       Maximum="{Binding ProgressMaximum}"
                       Visibility="{Binding IsBusy, Converter={StaticResource VisibleWhen}}"
                       Value="{Binding ProgressValue}" />
          <Button HorizontalAlignment="Stretch"
                  Command="{Binding LoadCommand}"
                  Style="{StaticResource PrimaryButton}"
                  ToolTip="Download rates from api.nbrb.by (F5)">
            <StackPanel Orientation="Horizontal">
              <Path Margin="0,0,8,0" Data="{StaticResource Icon.Download}" Style="{StaticResource Icon}" />
              <TextBlock>
                <Run Text="Load rates" />
                <Run Text="{Binding SelectedCount, Mode=OneWay, StringFormat='({0})'}" />
              </TextBlock>
            </StackPanel>
          </Button>
          <Button Margin="0,8,0,0"
                  HorizontalAlignment="Center"
                  Command="{Binding LoadCancelCommand}"
                  Content="Cancel"
                  Style="{StaticResource SidebarLinkButton}"
                  Visibility="{Binding IsBusy, Converter={StaticResource VisibleWhen}}" />
        </StackPanel>

        <!-- Currencies -->
        <DockPanel>
          <DockPanel DockPanel.Dock="Top">
            <Button Margin="10,0,4,0"
                    VerticalAlignment="Top"
                    Command="{Binding ClearCurrenciesCommand}"
                    Content="None"
                    DockPanel.Dock="Right"
                    Style="{StaticResource SidebarLinkButton}" />
            <Button VerticalAlignment="Top"
                    Command="{Binding SelectAllCurrenciesCommand}"
                    Content="All"
                    DockPanel.Dock="Right"
                    Style="{StaticResource SidebarLinkButton}" />
            <TextBlock Style="{StaticResource SidebarHeader}" Text="CURRENCIES" />
          </DockPanel>
          <TextBox Margin="0,0,0,8"
                   DockPanel.Dock="Top"
                   Style="{StaticResource SidebarInputBox}"
                   Tag="Find a currency…"
                   Text="{Binding CurrencySearch, UpdateSourceTrigger=PropertyChanged}" />
          <Border Margin="0,0,0,14" Padding="6" Style="{StaticResource SidebarSection}">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding VisibleCurrencies}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:CurrencyOptionViewModel}">
                    <CheckBox Margin="6,4" IsChecked="{Binding IsSelected}" Style="{StaticResource SidebarCheckBox}">
                      <DockPanel>
                        <TextBlock Width="40" FontWeight="SemiBold" Foreground="White" Text="{Binding Code}" />
                        <TextBlock DockPanel.Dock="Right" Margin="6,0,0,0" FontSize="11" Foreground="{StaticResource SidebarMutedBrush}" Text="{Binding ScaleText}" />
                        <TextBlock Foreground="{StaticResource SidebarMutedBrush}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                      </DockPanel>
                    </CheckBox>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Border>
        </DockPanel>
      </DockPanel>
    </Border>

    <!-- ============================== Content ============================== -->
    <Grid Grid.Column="1" Margin="24,20,24,16">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="300" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- Header -->
      <DockPanel Margin="0,0,0,16">
        <StackPanel VerticalAlignment="Center" DockPanel.Dock="Right" Orientation="Horizontal">
          <TextBlock Margin="0,0,10,0" VerticalAlignment="Center" Style="{StaticResource MutedText}" Text="Chart" />
          <ComboBox MinWidth="110"
                    ItemsSource="{Binding LoadedCurrencies}"
                    SelectedItem="{Binding SelectedChartCurrency}"
                    Style="{StaticResource FieldCombo}" />
        </StackPanel>
        <StackPanel>
          <TextBlock Style="{StaticResource PageTitle}" Text="Official exchange rates" />
          <TextBlock Style="{StaticResource MutedText}" Text="Belarusian rubles per unit (or per scale) of foreign currency" />
        </StackPanel>
      </DockPanel>

      <!-- Statistics -->
      <UniformGrid Grid.Row="1" Margin="0,0,0,12" Columns="4">
        <Border Margin="0,0,6,0" Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Style="{StaticResource FieldLabel}" Text="LATEST RATE" />
            <TextBlock Style="{StaticResource StatValue}" Text="{Binding Statistics.Last.Rate, StringFormat=N4, FallbackValue=—}" />
            <TextBlock Style="{StaticResource MutedText}" Text="{Binding Statistics.Last.Date, StringFormat='{}{0:dd MMM yyyy}', FallbackValue=''}" />
          </StackPanel>
        </Border>
        <Border Margin="6,0" Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Style="{StaticResource FieldLabel}" Text="CHANGE OVER PERIOD" />
            <TextBlock x:Name="ChangeValue" Text="{Binding Statistics.ChangePercent, StringFormat='{}{0:+0.00;-0.00;0.00}%', FallbackValue=—}">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource StatValue}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Statistics.Change, Converter={StaticResource SignConverter}}" Value="1">
                      <Setter Property="Foreground" Value="{StaticResource PublishedBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Statistics.Change, Converter={StaticResource SignConverter}}" Value="-1">
                      <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <TextBlock Style="{StaticResource MutedText}" Text="{Binding Statistics.Change, StringFormat='{}{0:+0.0000;-0.0000;0} BYN', FallbackValue=''}" />
          </StackPanel>
        </Border>
        <Border Margin="6,0" Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Style="{StaticResource FieldLabel}" Text="MINIMUM" />
            <TextBlock Style="{StaticResource StatValue}" Text="{Binding Statistics.Min.Rate, StringFormat=N4, FallbackValue=—}" />
            <TextBlock Style="{StaticResource MutedText}" Text="{Binding Statistics.Min.Date, StringFormat='{}{0:dd MMM yyyy}', FallbackValue=''}" />
          </StackPanel>
        </Border>
        <Border Margin="6,0,0,0" Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Style="{StaticResource FieldLabel}" Text="MAXIMUM" />
            <TextBlock Style="{StaticResource StatValue}" Text="{Binding Statistics.Max.Rate, StringFormat=N4, FallbackValue=—}" />
            <TextBlock Style="{StaticResource MutedText}" Text="{Binding Statistics.Max.Date, StringFormat='{}{0:dd MMM yyyy}', FallbackValue=''}" />
          </StackPanel>
        </Border>
      </UniformGrid>

      <!-- Chart -->
      <Border Grid.Row="2" Margin="0,0,0,12" Style="{StaticResource Card}">
        <Grid>
          <telerik:RadCartesianChart Visibility="{Binding HasChart, Converter={StaticResource VisibleWhen}}">
            <telerik:RadCartesianChart.HorizontalAxis>
              <telerik:DateTimeContinuousAxis LabelFormat="dd MMM"
                                              LineStroke="{StaticResource DividerBrush}"
                                              MajorTickLength="0"
                                              MaximumTicks="8"
                                              PlotMode="OnTicks"
                                              Foreground="{StaticResource MutedTextBrush}" />
            </telerik:RadCartesianChart.HorizontalAxis>
            <telerik:RadCartesianChart.VerticalAxis>
              <telerik:LinearAxis LabelFormat="N3"
                                  LineStroke="Transparent"
                                  MajorTickLength="0"
                                  RangeExtendDirection="Both"
                                  Foreground="{StaticResource MutedTextBrush}" />
            </telerik:RadCartesianChart.VerticalAxis>
            <telerik:RadCartesianChart.Grid>
              <telerik:CartesianChartGrid MajorLinesVisibility="Y">
                <telerik:CartesianChartGrid.MajorYLineStyle>
                  <Style TargetType="Line">
                    <Setter Property="Stroke" Value="#EEF0F4" />
                  </Style>
                </telerik:CartesianChartGrid.MajorYLineStyle>
              </telerik:CartesianChartGrid>
            </telerik:RadCartesianChart.Grid>
            <telerik:RadCartesianChart.Behaviors>
              <telerik:ChartTrackBallBehavior ShowIntersectionPoints="True" />
            </telerik:RadCartesianChart.Behaviors>
            <telerik:SplineAreaSeries CategoryBinding="Date"
                                      TrackBallInfoTemplate="{StaticResource TrackBallInfo}"
                                      Fill="#1F4F46E5"
                                      ItemsSource="{Binding ChartPoints}"
                                      Stroke="{StaticResource AccentBrush}"
                                      StrokeMode="Points"
                                      StrokeThickness="2.5"
                                      ValueBinding="Rate" />
          </telerik:RadCartesianChart>
          <StackPanel HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Visibility="{Binding HasChart, Converter={StaticResource CollapsedWhen}}">
            <Path HorizontalAlignment="Center" Data="{StaticResource Icon.Chart}" Fill="{StaticResource BorderStrongBrush}" Style="{StaticResource LargeIcon}" />
            <TextBlock Margin="0,10,0,4" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" Text="No rates loaded yet" />
            <TextBlock HorizontalAlignment="Center" Style="{StaticResource MutedText}" Text="Pick currencies and a period on the left, then press “Load rates”." />
          </StackPanel>
        </Grid>
      </Border>

      <!-- Table -->
      <Border Grid.Row="3" Padding="0" Style="{StaticResource Card}">
        <DockPanel>
          <DockPanel Margin="16,12" DockPanel.Dock="Top">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button Margin="0,0,8,0" Command="{Binding SaveCommand}" Style="{StaticResource SecondaryButton}" ToolTip="Save edited rates (Ctrl+S)">
                <StackPanel Orientation="Horizontal">
                  <Path Margin="0,0,6,0" Data="{StaticResource Icon.Save}" Style="{StaticResource Icon}" />
                  <TextBlock Text="Save" />
                </StackPanel>
              </Button>
              <Button Command="{Binding ExportCsvCommand}" Style="{StaticResource SecondaryButton}" ToolTip="Export visible rows to CSV (Ctrl+E)">
                <StackPanel Orientation="Horizontal">
                  <Path Margin="0,0,6,0" Data="{StaticResource Icon.Table}" Style="{StaticResource Icon}" />
                  <TextBlock Text="Export CSV" />
                </StackPanel>
              </Button>
            </StackPanel>
            <Grid Width="280" HorizontalAlignment="Left">
              <TextBox Padding="34,8,10,8"
                       Style="{StaticResource InputBox}"
                       Tag="Search by code, name or date…"
                       Text="{Binding TableSearch, UpdateSourceTrigger=PropertyChanged, Delay=150}" />
              <Path Margin="11,0,0,0"
                    HorizontalAlignment="Left"
                    Data="{StaticResource Icon.Search}"
                    Fill="{StaticResource MutedTextBrush}"
                    IsHitTestVisible="False"
                    Style="{StaticResource Icon}" />
            </Grid>
            <TextBlock Margin="14,0,0,0" VerticalAlignment="Center" Style="{StaticResource MutedText}" Text="{Binding RowsSummary}" />
          </DockPanel>

          <telerik:RadGridView x:Name="RatesGrid"
                               AlternateRowBackground="#F9FAFB"
                               AlternationCount="2"
                               AutoGenerateColumns="False"
                               Background="White"
                               BorderThickness="0,1,0,0"
                               BorderBrush="{StaticResource DividerBrush}"
                               CanUserFreezeColumns="False"
                               FontSize="13"
                               GridLinesVisibility="Horizontal"
                               GroupPanelBackground="{StaticResource SurfaceBrush}"
                               GroupPanelForeground="{StaticResource MutedTextBrush}"
                               GroupRenderMode="Flat"
                               ItemsSource="{Binding Rows}"
                               RowHeight="34"
                               RowIndicatorVisibility="Collapsed"
                               SelectionMode="Extended"
                               ShowGroupPanel="True">
            <telerik:RadGridView.Resources>
              <!-- Flat, light header and group panel instead of the dark Office_Black defaults. -->
              <Style TargetType="telerik:GridViewHeaderCell">
                <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontSize" Value="12" />
              </Style>
              <Style TargetType="telerik:GridViewHeaderRow">
                <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
              </Style>
            </telerik:RadGridView.Resources>
            <telerik:RadGridView.RowStyle>
              <Style TargetType="telerik:GridViewRow">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsEdited}" Value="True">
                    <Setter Property="Background" Value="#FFFBEB" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </telerik:RadGridView.RowStyle>
            <telerik:RadGridView.Columns>
              <telerik:GridViewDataColumn Width="110" DataFormatString="{}{0:dd.MM.yyyy}" DataMemberBinding="{Binding Date}" Header="Date" IsReadOnly="True" />
              <telerik:GridViewDataColumn Width="80" DataMemberBinding="{Binding Code}" Header="Code" IsReadOnly="True" />
              <telerik:GridViewDataColumn Width="*" DataMemberBinding="{Binding Name}" Header="Currency" IsReadOnly="True" />
              <telerik:GridViewDataColumn Width="70" DataMemberBinding="{Binding Scale}" Header="Scale" IsReadOnly="True" TextAlignment="Right" />
              <telerik:GridViewDataColumn Width="120" DataFormatString="{}{0:N4}" DataMemberBinding="{Binding Rate, Mode=TwoWay}" Header="Rate, BYN ✎" TextAlignment="Right" />
              <telerik:GridViewDataColumn Width="110" DataMemberBinding="{Binding ChangePercent}" Header="Day change" IsReadOnly="True">
                <telerik:GridViewDataColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock HorizontalAlignment="Right"
                               FontWeight="SemiBold"
                               Foreground="{Binding Trend, Converter={StaticResource TrendBrush}}"
                               Text="{Binding ChangeText}" />
                  </DataTemplate>
                </telerik:GridViewDataColumn.CellTemplate>
              </telerik:GridViewDataColumn>
            </telerik:RadGridView.Columns>
          </telerik:RadGridView>
        </DockPanel>
      </Border>
    </Grid>

    <!-- Status bar -->
    <Border Grid.Row="1"
            Grid.Column="1"
            Padding="16,6"
            Background="{StaticResource CardBrush}"
            BorderBrush="{StaticResource DividerBrush}"
            BorderThickness="0,1,0,0">
      <DockPanel>
        <TextBlock DockPanel.Dock="Right" Style="{StaticResource MutedText}" Text="F5 load  ·  Ctrl+S save  ·  Ctrl+E export  ·  Source: api.nbrb.by" />
        <TextBlock Margin="0,0,16,0" Style="{StaticResource MutedText}" Text="{Binding StatusMessage}" />
      </DockPanel>
    </Border>
  </Grid>
</Window>
